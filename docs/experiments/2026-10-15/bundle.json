  "behavior_examples": [
    {
      "input": {
        "assessment": {
          "month": "2026-10",
          "budget_limit_cny": 1500,
          "spent_cny": 1000,
          "remaining_cny": 500,
          "planned_amount_cny": 30,
          "projected_remaining_cny": 470,
          "cash_available_cny": 800,
          "projected_cash_cny": 770,
          "within_budget": true,
          "within_cash": true
        },
