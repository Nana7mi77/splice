{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://splice.example/specs/plugin.schema.json",
  "title": "Splice v0.1 Plugin Manifest",
  "description": "受限、纯数据的声明式插件协议；只允许列出的表达式和执行原语，不加载任意代码。",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "domain": {
      "enum": [
        "food",
        "finance"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "capability": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
    },
    "permissions": {
      "type": "array",
      "items": {
        "enum": [
          "food:read",
          "food_order_draft:write",
          "finance:read",
          "finance_budget:read"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "resources": {
      "type": "array",
      "items": {
        "enum": [
          "food_merchants",
          "menu_items",
          "delivery_fees",
          "food_order_drafts",
          "cash_accounts",
          "portfolio_positions",
          "asset_valuation_snapshots",
          "expense_transactions",
          "monthly_budgets"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "preconditions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/expression"
      }
    },
    "effects": {
      "type": "array",
      "items": {
        "enum": [
          "draft.create"
        ]
      },
      "maxItems": 1,
      "uniqueItems": true
    },
    "input_schema": {
      "$ref": "#/$defs/contract_schema"
    },
    "output_schema": {
      "$ref": "#/$defs/contract_schema"
    },
    "execution": {
      "type": "object",
      "properties": {
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/read_step"
              },
              {
                "$ref": "#/$defs/filter_step"
              },
              {
                "$ref": "#/$defs/project_step"
              },
              {
                "$ref": "#/$defs/aggregate_step"
              },
              {
                "$ref": "#/$defs/compare_step"
              },
              {
                "$ref": "#/$defs/sort_step"
              },
              {
                "$ref": "#/$defs/assert_step"
              },
              {
                "$ref": "#/$defs/insert_step"
              }
            ]
          }
        },
        "output": {
          "$ref": "#/$defs/object_expression"
        }
      },
      "required": [
        "steps",
        "output"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "version",
    "domain",
    "description",
    "examples",
    "capability",
    "permissions",
    "resources",
    "preconditions",
    "effects",
    "input_schema",
    "output_schema",
    "execution"
  ],
  "additionalProperties": false,
  "$defs": {
    "expression": {
      "if": {
        "type": "object"
      },
      "then": {
        "if": {
          "required": [
            "op"
          ]
        },
        "then": {
          "$ref": "#/$defs/operator_expression"
        },
        "else": {
          "$ref": "#/$defs/object_expression"
        }
      },
      "else": {
        "anyOf": [
          {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          },
          {
            "type": "array",
            "items": {
              "$ref": "#/$defs/expression"
            }
          }
        ]
      }
    },
    "operator_expression": {
      "type": "object",
      "properties": {
        "op": {
          "enum": [
            "add",
            "sub",
            "mul",
            "min",
            "max",
            "eq",
            "ne",
            "lt",
            "lte",
            "gt",
            "gte",
            "and",
            "or",
            "not",
            "contains",
            "sum",
            "count",
            "lookup",
            "first"
          ]
        },
        "args": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/expression"
          }
        }
      },
      "required": [
        "op",
        "args"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "op": {
                "const": "add"
              }
            }
          },
          "then": {
            "properties": {
              "args": {
                "minItems": 2,
                "maxItems": 2
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "sub"
              }
            }
          },
          "then": {
            "properties": {
              "args": {
                "minItems": 2,
                "maxItems": 2
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "mul"
              }
            }
          },
          "then": {
            "properties": {
              "args": {
                "minItems": 2,
                "maxItems": 2
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "min"
              }
            }
          },
          "then": {
            "properties": {
              "args": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "max"
              }
            }
          },
          "then": {
            "properties": {
              "args": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "eq"
              }
            }
          },
          "then": {
            "properties": {
              "args": {
                "minItems": 2,
                "maxItems": 2
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "ne"
              }
            }
          },
          "then": {
            "properties": {
              "args": {
                "minItems": 2,
                "maxItems": 2
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "lt"
              }
            }
          },
          "then": {
            "properties": {
              "args": {
                "minItems": 2,
                "maxItems": 2
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "lte"
              }
            }
          },
          "then": {
            "properties": {
              "args": {
                "minItems": 2,
                "maxItems": 2
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "gt"
              }
            }
          },
          "then": {
            "properties": {
              "args": {
                "minItems": 2,
                "maxItems": 2
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "gte"
              }
            }
          },
          "then": {
            "properties": {
              "args": {
                "minItems": 2,
                "maxItems": 2
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "and"
              }
            }
          },
          "then": {
            "properties": {
              "args": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "or"
              }
            }
          },
          "then": {
            "properties": {
              "args": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "not"
              }
            }
          },
          "then": {
            "properties": {
              "args": {
                "minItems": 1,
                "maxItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "contains"
              }
            }
          },
          "then": {
            "properties": {
              "args": {
                "minItems": 2,
                "maxItems": 2
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "sum"
              }
            }
          },
          "then": {
            "properties": {
              "args": {
                "minItems": 2,
                "maxItems": 2
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "count"
              }
            }
          },
          "then": {
            "properties": {
              "args": {
                "minItems": 1,
                "maxItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "lookup"
              }
            }
          },
          "then": {
            "properties": {
              "args": {
                "minItems": 4,
                "maxItems": 4
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "first"
              }
            }
          },
          "then": {
            "properties": {
              "args": {
                "minItems": 1,
                "maxItems": 1
              }
            }
          }
        }
      ]
    },
    "object_expression": {
      "type": "object",
      "propertyNames": {
        "not": {
          "const": "op"
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/expression"
      }
    },
    "field_schema": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "string",
            "number",
            "integer",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "description": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "x-fact": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/field_schema"
          }
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "additionalProperties": {
          "const": false
        },
        "items": {
          "$ref": "#/$defs/field_schema"
        },
        "minItems": {
          "type": "integer",
          "minimum": 0
        },
        "maxItems": {
          "type": "integer",
          "minimum": 0
        },
        "uniqueItems": {
          "type": "boolean"
        },
        "minLength": {
          "type": "integer",
          "minimum": 0
        },
        "maxLength": {
          "type": "integer",
          "minimum": 0
        },
        "pattern": {
          "type": "string"
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "exclusiveMinimum": {
          "type": "number"
        },
        "exclusiveMaximum": {
          "type": "number"
        },
        "enum": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true
        },
        "const": {}
      },
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "object"
              }
            }
          },
          "then": {
            "required": [
              "properties",
              "required",
              "additionalProperties"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "array"
              }
            }
          },
          "then": {
            "required": [
              "items"
            ]
          }
        }
      ]
    },
    "fact_schema": {
      "allOf": [
        {
          "$ref": "#/$defs/field_schema"
        },
        {
          "required": [
            "x-fact"
          ]
        }
      ]
    },
    "contract_schema": {
      "type": "object",
      "properties": {
        "type": {
          "const": "object"
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/fact_schema"
          }
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "additionalProperties": {
          "const": false
        }
      },
      "required": [
        "type",
        "properties",
        "required",
        "additionalProperties"
      ],
      "additionalProperties": false
    },
    "read_step": {
      "type": "object",
      "properties": {
        "op": {
          "const": "read"
        },
        "resource": {
          "enum": [
            "food_merchants",
            "menu_items",
            "delivery_fees",
            "food_order_drafts",
            "cash_accounts",
            "portfolio_positions",
            "asset_valuation_snapshots",
            "expense_transactions",
            "monthly_budgets"
          ]
        },
        "as": {
          "type": "string",
          "pattern": "^(?!(?:input|row|rows)$)[A-Za-z][A-Za-z0-9_]*$"
        }
      },
      "required": [
        "op",
        "resource",
        "as"
      ],
      "additionalProperties": false
    },
    "filter_step": {
      "type": "object",
      "properties": {
        "op": {
          "const": "filter"
        },
        "from": {
          "type": "string",
          "pattern": "^(?!(?:input|row|rows)$)[A-Za-z][A-Za-z0-9_]*$"
        },
        "where": {
          "$ref": "#/$defs/expression"
        },
        "as": {
          "type": "string",
          "pattern": "^(?!(?:input|row|rows)$)[A-Za-z][A-Za-z0-9_]*$"
        }
      },
      "required": [
        "op",
        "from",
        "where",
        "as"
      ],
      "additionalProperties": false
    },
    "project_step": {
      "type": "object",
      "properties": {
        "op": {
          "const": "project"
        },
        "from": {
          "type": "string",
          "pattern": "^(?!(?:input|row|rows)$)[A-Za-z][A-Za-z0-9_]*$"
        },
        "values": {
          "$ref": "#/$defs/object_expression"
        },
        "as": {
          "type": "string",
          "pattern": "^(?!(?:input|row|rows)$)[A-Za-z][A-Za-z0-9_]*$"
        }
      },
      "required": [
        "op",
        "values",
        "as"
      ],
      "additionalProperties": false
    },
    "aggregate_step": {
      "type": "object",
      "properties": {
        "op": {
          "const": "aggregate"
        },
        "from": {
          "type": "string",
          "pattern": "^(?!(?:input|row|rows)$)[A-Za-z][A-Za-z0-9_]*$"
        },
        "values": {
          "$ref": "#/$defs/object_expression"
        },
        "as": {
          "type": "string",
          "pattern": "^(?!(?:input|row|rows)$)[A-Za-z][A-Za-z0-9_]*$"
        }
      },
      "required": [
        "op",
        "from",
        "values",
        "as"
      ],
      "additionalProperties": false
    },
    "compare_step": {
      "type": "object",
      "properties": {
        "op": {
          "const": "compare"
        },
        "value": {
          "$ref": "#/$defs/expression"
        },
        "as": {
          "type": "string",
          "pattern": "^(?!(?:input|row|rows)$)[A-Za-z][A-Za-z0-9_]*$"
        }
      },
      "required": [
        "op",
        "value",
        "as"
      ],
      "additionalProperties": false
    },
    "sort_step": {
      "type": "object",
      "properties": {
        "op": {
          "const": "sort"
        },
        "from": {
          "type": "string",
          "pattern": "^(?!(?:input|row|rows)$)[A-Za-z][A-Za-z0-9_]*$"
        },
        "by": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "direction": {
          "enum": [
            "asc",
            "desc"
          ]
        },
        "as": {
          "type": "string",
          "pattern": "^(?!(?:input|row|rows)$)[A-Za-z][A-Za-z0-9_]*$"
        }
      },
      "required": [
        "op",
        "from",
        "by",
        "direction",
        "as"
      ],
      "additionalProperties": false
    },
    "assert_step": {
      "type": "object",
      "properties": {
        "op": {
          "const": "assert"
        },
        "condition": {
          "$ref": "#/$defs/expression"
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "op",
        "condition",
        "message"
      ],
      "additionalProperties": false
    },
    "insert_step": {
      "type": "object",
      "properties": {
        "op": {
          "const": "insert"
        },
        "resource": {
          "enum": [
            "food_merchants",
            "menu_items",
            "delivery_fees",
            "food_order_drafts",
            "cash_accounts",
            "portfolio_positions",
            "asset_valuation_snapshots",
            "expense_transactions",
            "monthly_budgets"
          ]
        },
        "values": {
          "$ref": "#/$defs/object_expression"
        },
        "as": {
          "type": "string",
          "pattern": "^(?!(?:input|row|rows)$)[A-Za-z][A-Za-z0-9_]*$"
        }
      },
      "required": [
        "op",
        "resource",
        "values",
        "as"
      ],
      "additionalProperties": false
    }
  }
}
