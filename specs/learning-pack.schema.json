{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://splice.example/specs/learning-pack.schema.json",
  "title": "Splice Capability Learning Pack v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "plugin_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "plugin_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "domain": {
      "enum": [
        "food",
        "finance"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      },
      "minItems": 1,
      "maxItems": 40,
      "uniqueItems": true
    },
    "examples": {
      "type": "array",
      "minItems": 3,
      "maxItems": 12,
      "items": {
        "type": "object",
        "properties": {
          "utterance": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "intent": {
            "title": "Splice v0.1 Structured Intent",
            "description": "端侧 Mock 适配器输出语义事实与目标，插件绑定由 Registry 与通用 Planner 完成。",
            "type": "object",
            "properties": {
              "goal": {
                "type": "string",
                "minLength": 1
              },
              "requested_outputs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "facts": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
                }
              },
              "gates": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "fact": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
                    },
                    "equals": {}
                  },
                  "required": [
                    "fact",
                    "equals"
                  ],
                  "additionalProperties": false
                }
              },
              "requires_confirmation": {
                "type": "boolean"
              },
              "authorized_effects": {
                "type": "array",
                "items": {
                  "enum": [
                    "draft.create"
                  ]
                },
                "uniqueItems": true
              },
              "constraints": {
                "type": "object",
                "properties": {
                  "place_order": {
                    "const": false
                  },
                  "make_payment": {
                    "const": false
                  }
                },
                "required": [
                  "place_order",
                  "make_payment"
                ],
                "additionalProperties": false
              },
              "language": {
                "type": "string",
                "minLength": 1
              },
              "utterance": {
                "type": "string",
                "minLength": 1
              },
              "adapter": {
                "enum": [
                  "mock",
                  "local"
                ]
              }
            },
            "required": [
              "goal",
              "requested_outputs",
              "facts",
              "gates",
              "requires_confirmation",
              "authorized_effects",
              "constraints",
              "language",
              "utterance",
              "adapter"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "utterance",
          "intent"
        ],
        "additionalProperties": false
      }
    },
    "negative_examples": {
      "type": "array",
      "minItems": 2,
      "maxItems": 10,
      "items": {
        "type": "object",
        "properties": {
          "utterance": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "required": [
          "utterance",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "fact_dependencies": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "minItems": 1,
        "maxItems": 40,
        "uniqueItems": true
      }
    },
    "required_permissions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      },
      "minItems": 1,
      "maxItems": 40,
      "uniqueItems": true
    },
    "supported_manifest_versions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      },
      "minItems": 1,
      "maxItems": 40,
      "uniqueItems": true
    },
    "adaptation_mode": {
      "const": "dynamic_context"
    }
  },
  "required": [
    "schema_version",
    "plugin_id",
    "plugin_version",
    "manifest_sha256",
    "domain",
    "description",
    "keywords",
    "examples",
    "negative_examples",
    "fact_dependencies",
    "required_permissions",
    "supported_manifest_versions",
    "adaptation_mode"
  ],
  "additionalProperties": false
}
